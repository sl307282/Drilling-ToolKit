<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_background"
    android:fitsSystemWindows="true">

    <!-- Center Container (Anchored at exact vertical & horizontal screen center) -->
    <FrameLayout
        android:id="@+id/splash_card"
        android:layout_width="@dimen/splash_card_size"
        android:layout_height="@dimen/splash_card_size"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_splash_card"
        android:elevation="@dimen/splash_card_elevation"
        android:outlineProvider="background">

        <ImageView
            android:id="@+id/splash_logo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/splash_logo_padding"
            android:scaleType="fitCenter"
            android:contentDescription="@string/splash_app_name"
            android:src="@drawable/splash_logo" />
    </FrameLayout>

    <!-- App Name: Below container in landscape, Bold, 24sp, letter-spacing 0.5sp, #1F2A2E -->
    <TextView
        android:id="@+id/splash_app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/splash_card"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/splash_title_margin_top"
        android:fontFamily="sans-serif"
        android:gravity="center_horizontal"
        android:letterSpacing="0.02"
        android:text="@string/splash_app_name"
        android:textColor="@color/splash_title_color"
        android:textSize="@dimen/splash_title_text_size"
        android:textStyle="bold" />

    <!-- Bottom Tagline: In landscape, Medium, 14sp, #3E7A52 -->
    <TextView
        android:id="@+id/splash_tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="@dimen/splash_tagline_margin_bottom"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_horizontal"
        android:text="@string/splash_tagline"
        android:textColor="@color/splash_tagline_color"
        android:textSize="@dimen/splash_tagline_text_size" />

</RelativeLayout>
